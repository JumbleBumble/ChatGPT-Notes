{
	"name": "chatgpt-notes",
	"displayName": "ChatGPT Notes",
	"version": "0.2.0",
	"description": "Save ChatGPT messages as notes for later. Just save, organize, and find the messages you want to keep.  ",
	"author": "Jumble",
	"scripts": {
		"dev": "plasmo dev",
		"build": "plasmo build",
		"package": "plasmo package",
		"icons": "node scripts/generate-icons.cjs",
		"lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
		"typecheck": "tsc --noEmit",
		"lint:css": "stylelint \"src/**/*.css\"",
		"lint:css:fix": "stylelint \"src/**/*.css\" --fix",
		"test": "vitest",
		"test:watch": "vitest --watch",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@floating-ui/dom": "^1.8.0",
		"@plasmohq/storage": "^1.15.0",
		"@tiptap/core": "3.31.0",
		"@tiptap/extension-table": "3.31.0",
		"@tiptap/pm": "3.31.0",
		"@tiptap/react": "3.31.0",
		"@tiptap/starter-kit": "3.31.0",
		"@types/turndown": "^5.0.6",
		"css-selector-generator": "^3.9.4",
		"dompurify": "^3.4.14",
		"jspdf": "^4.2.1",
		"lodash": "^4.18.1",
		"lucide-react": "^1.34.0",
		"motion": "^13.2.0",
		"papaparse": "^5.7.0",
		"plasmo": "^0.50.1",
		"react": "18.2.0",
		"react-dom": "18.2.0",
		"turndown": "^7.2.4",
		"turndown-plugin-gfm": "^1.0.2"
	},
	"devDependencies": {
		"@eslint/js": "^9.35.0",
		"@ianvs/prettier-plugin-sort-imports": "4.1.1",
		"@types/chrome": "0.0.258",
		"@types/dompurify": "^3.0.5",
		"@types/node": "^22.20.1",
		"@types/react": "18.2.48",
		"@types/react-dom": "18.2.18",
		"@vitest/coverage-v8": "^5.0.0",
		"autoprefixer": "10.5.4",
		"eslint": "^9.35.0",
		"eslint-plugin-react-hooks": "^5.2.0",
		"globals": "^16.4.0",
		"happy-dom": "^20.14.0",
		"postcss": "8.5.26",
		"prettier": "3.2.4",
		"sharp": "^0.35.4",
		"stylelint": "^16.24.0",
		"stylelint-config-recommended": "^17.0.0",
		"stylelint-config-tailwindcss": "^1.0.1",
		"tailwindcss": "^3.4.17",
		"typescript": "5.3.3",
		"typescript-eslint": "^8.43.0",
		"vitest": "^5.0.0"
	},
	"manifest": {
		"permissions": [
			"storage"
		],
		"host_permissions": [
			"https://chatgpt.com/*",
			"https://chat.openai.com/*"
		]
	},
	"overrides": {
		"@types/react": "18.2.48",
		"@types/react-dom": "18.2.18"
	}
}
